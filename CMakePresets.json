{
  "version": 9,
  "configurePresets": [
    {
      "name": "vs2026-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/obj",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/bin",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/bin",
        "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/build/bin"
      }
    },
    {
      "name": "vs2026-debug",
      "inherits": "vs2026-base",
      "displayName": "Visual Studio 18 2026 Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vs2026-release",
      "inherits": "vs2026-base",
      "displayName": "Visual Studio 18 2026 Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64 Debug",
      "configurePreset": "vs2026-debug"
    },
    {
      "name": "x64 Release",
      "configurePreset": "vs2026-release"
    }
  ]
}